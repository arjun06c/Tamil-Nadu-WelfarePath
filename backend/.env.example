# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.qlafckz.mongodb.net/tn_welfarepath?retryWrites=true&w=majority

# Authentication Security Secret
# Generate a strong 64-character random string for production
JWT_SECRET=tn_welfarepath_super_secure_production_jwt_secret_key_2026_replace_me
JWT_EXPIRES_IN=7d

# Allowed Frontend URL for CORS
FRONTEND_URL=https://your-frontend.vercel.app

# DigiLocker Integration Mode (mock, sandbox, or production)
DIGILOCKER_MODE=mock
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=https://your-backend-service.onrender.com/api/integrations/digilocker/callback
